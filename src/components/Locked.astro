---
// A passcode-protected project. The file at `src` is scrambled (see scripts/lock-project.mjs) and is only
// unscrambled in the visitor's browser when they enter the right passcode. The passcode is never stored here.
import { url, site } from '../site';

interface Props {
  src: string; // e.g. "/locked/data-platform-concept.json" (a file in public/)
  title?: string; // accessible name for the unlocked frame
}
const { src, title = 'Project walkthrough' } = Astro.props;
---

<div class="locked" data-src={url(src)}>
  <form class="lock-form">
    <p class="mono lock-kicker">Protected project</p>
    <p class="lock-copy">This project is under NDA. Enter the passcode to view it.</p>
    <label class="mono" for="lock-code">Passcode</label>
    <div class="lock-row">
      <input id="lock-code" name="code" type="password" autocomplete="off" autocapitalize="off" spellcheck="false" required />
      <button type="submit">Unlock</button>
    </div>
    <p class="lock-msg mono" role="status" aria-live="polite"></p>
    <p class="lock-ask">Need the passcode? <a href={`mailto:${site.email}?subject=Portfolio%20passcode`}>Email me</a>.</p>
  </form>
  <div class="lock-view" hidden>
    <iframe title={title} allow="fullscreen; autoplay" allowfullscreen></iframe>
    <p class="mono lock-hint">Press Play inside the frame. Full screen is in its controls.</p>
  </div>
</div>

<script is:inline>
  (() => {
    const b64 = (s) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
    document.querySelectorAll('.locked').forEach((box) => {
      const form = box.querySelector('.lock-form');
      const msg = box.querySelector('.lock-msg');
      const btn = form.querySelector('button');
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const code = form.code.value;
        btn.disabled = true;
        msg.textContent = 'Checking…';
        try {
          const res = await fetch(box.dataset.src);
          if (!res.ok) throw new Error('missing');
          const d = await res.json();
          const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(code), 'PBKDF2', false, ['deriveKey']);
          const key = await crypto.subtle.deriveKey(
            { name: 'PBKDF2', hash: 'SHA-256', salt: b64(d.salt), iterations: d.iter },
            base, { name: 'AES-GCM', length: 256 }, false, ['decrypt'],
          );
          let plain;
          try {
            plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(d.iv) }, key, b64(d.ct));
          } catch {
            msg.textContent = "That passcode didn't work. Check it and try again.";
            form.code.select();
            return;
          }
          const view = box.querySelector('.lock-view');
          view.querySelector('iframe').srcdoc = new TextDecoder().decode(plain);
          form.hidden = true;
          view.hidden = false;
          view.querySelector('iframe').focus();
        } catch {
          msg.textContent = "Couldn't load the project. Refresh the page and try again.";
        } finally {
          btn.disabled = false;
        }
      });
    });
  })();
</script>

<style>
  .locked { margin: 0.5rem 0 2rem; }
  .lock-form {
    border: var(--rule);
    box-shadow: var(--shadow);
    background: var(--bg-elev);
    padding: clamp(1.25rem, 4vw, 2rem);
    max-width: 560px;
  }
  .lock-kicker { margin: 0; color: var(--red-hot); text-transform: uppercase; letter-spacing: 0.08em; }
  .lock-copy { margin: 0.5rem 0 1.25rem; font-size: 1.15rem; }
  .lock-form label { display: block; margin-bottom: 0.4rem; color: var(--muted); }
  .lock-row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .lock-row input {
    flex: 1 1 14rem;
    min-width: 0;
    font: inherit;
    font-family: var(--font-mono);
    color: var(--text);
    background: var(--bg);
    border: var(--rule);
    border-radius: 0;
    padding: 0.7rem 0.85rem;
  }
  .lock-row button {
    font: inherit;
    font-weight: 600;
    color: var(--accent-ink);
    background: var(--accent);
    border: var(--rule);
    border-radius: 0;
    padding: 0.7rem 1.4rem;
    cursor: pointer;
  }
  .lock-row button:hover { background: var(--grad-red); }
  .lock-row button:disabled { opacity: 0.6; cursor: progress; }
  .lock-row input:focus-visible,
  .lock-row button:focus-visible { outline: 3px solid var(--link); outline-offset: 2px; }
  .lock-msg { min-height: 1.4em; margin: 0.75rem 0 0; color: var(--warn); }
  .lock-ask { margin: 0.5rem 0 0; color: var(--muted); }
  .lock-view iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: var(--rule); background: #000; }
  .lock-hint { margin: 0.6rem 0 0; color: var(--muted); font-size: 0.85rem; }
</style>

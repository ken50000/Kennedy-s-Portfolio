---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorkCarousel from '../components/WorkCarousel.astro';
import Todo from '../components/Todo.astro';
import HeroMess from '../components/HeroMess.astro';
import { site, url } from '../site';

const studies = (await getCollection('case-studies'))
  .filter((s) => !s.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base>
  <section class="hero-band" aria-labelledby="hero-name">
    <div class="hero container">
      <!-- Interactive "clear the mess" hero. See docs/HERO_EFFECT.md and src/components/HeroMess.astro. -->
      <HeroMess />
      <div class="hero-row">
        <p class="role">{site.role}</p>
        <div class="intro-text">
          <p class="intro">
            I'm a UX designer who specializes in creating intuitive, visually polished experiences and simplifying
            complex workflows. I combine strong UI design, user-centered research, and rapid prototyping to turn
            complicated business problems into thoughtful, accessible solutions that make products easier to use.
          </p>
          <p class="intro-sub">
            I'm Kennedy. At Walmart Global Tech, I design the UI for ReimburseMe, the app associates use to get
            their expenses paid back. Before that, I helped launch Ani, an animanga social app, from its first
            screens.
          </p>
          <dl class="meta">
            <div><dt class="mono">Experience</dt><dd>{site.experience}</dd></div>
            <div><dt class="mono">Based in</dt><dd>{site.location}</dd></div>
            <div>
              <dt class="mono">Elsewhere</dt>
              <dd>{site.linkedin ? <a href={site.linkedin}>LinkedIn</a> : <span class="muted">LinkedIn link coming</span>}</dd>
            </div>
            <!-- Skating is on her About page; music came from Nacho (2026-10-27), so confirm with her. -->
            <div><dt class="mono">Off the clock</dt><dd>Skateboarding, music production</dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section id="work" class="work" aria-labelledby="work-title">
    <div class="work-head">
      <h2 id="work-title" class="work-title container">Work <span class="count">({studies.length})</span></h2>
    </div>
    <WorkCarousel studies={studies} />
  </section>
</Base>

<style>
  /* Hero: a red glow rising behind the name, closed off by a red rule. */
  .hero-band { background: var(--grad-glow); border-bottom: 2px solid var(--accent); }
  .hero { padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(2.5rem, 6vw, 4.5rem); }

  /* Under the name: her title in big white type, then the intro and facts beside it. */
  .hero-row {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.25rem, 4vw, 3.5rem);
    margin-top: clamp(1.75rem, 4vw, 3rem);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: var(--rule);
  }
  .role {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.2vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
    color: var(--text);
    margin: 0;
  }
  .intro-text { display: flex; flex-direction: column; }
  .intro {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    margin: 0 0 1.25rem;
  }
  .intro-sub { margin: 0 0 1.25rem; color: var(--muted, inherit); max-width: 60ch; }
  .meta { margin: 0.5rem 0 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 2px solid var(--accent); }
  .meta div { padding: 0.9rem 1rem 0.6rem; }
  .meta div:nth-child(odd) { padding-left: 0; }
  .meta div:nth-child(even) { border-left: var(--rule); }
  .meta div:nth-child(n + 3) { border-top: 1px solid var(--line-soft); }
  .meta dt { color: var(--red-hot); margin-bottom: 0.2rem; }
  .meta dd { margin: 0; font-weight: 600; }

  /* Work: a full-bleed red slab for the heading, then the 3D project carousel (src/components/WorkCarousel.astro). */
  .work { padding-top: 0; scroll-margin-top: 3.25rem; }
  .work-head { background: var(--grad-red); border-block: var(--rule); }
  .work-title {
    font-size: clamp(4.5rem, 17vw, 14rem);
    letter-spacing: -0.06em;
    line-height: 0.82;
    color: var(--accent-ink);
    margin-block: 0;
    padding-block: clamp(1.5rem, 4vw, 2.5rem) clamp(0.75rem, 2vw, 1.25rem);
  }
  .count { font-family: var(--font-mono); font-size: 0.16em; font-weight: 400; letter-spacing: 0; vertical-align: top; color: var(--accent-ink); }

  @media (max-width: 860px) {
    .hero-row { grid-template-columns: 1fr; }
  }
</style>
